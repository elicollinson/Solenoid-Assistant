# Copy to .env and fill in (bun loads .env automatically).
# Supported providers: Ollama-native and OpenAI-compatible (including LM Studio).

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Which interface to bind (default: 127.0.0.1 — this machine only).
#
# Loopback on purpose: this server answers questions about your messages,
# contacts, calendar and screenshots and has no authentication in front of it,
# so bound to 0.0.0.0 it is all of that offered to whatever wifi you are on.
# To reach it from another device, put it on your tailnet instead — see
# `bun run serve:tailscale`, which proxies from the tailnet to loopback.
# Set 0.0.0.0 only for a LAN you actually trust.
HOST=127.0.0.1

# Ordered, non-empty provider/model route chain. A failed task restarts from
# its original input on the next route. Supported providers: ollama, openai,
# and openrouter. LLM_PROVIDER + MODEL remain the single-route fallback when
# LLM_ROUTES is omitted.
LLM_ROUTES=[{"provider":"openai","model":"qwen/qwen3.5-9b"},{"provider":"openrouter","model":"google/gemma-4-31b-it"}]
LLM_PROVIDER=openai

# Ollama Cloud API key — create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Ollama-native base URL (used by the shared client factory in src/core/ollama.ts).
# Ollama Cloud: https://ollama.com
# Local Ollama fallback (no key needed): http://localhost:11434
OLLAMA_API_URL=https://ollama.com

# OpenAI-compatible endpoint. For a remote LM Studio instance:
#   OPENAI_BASE_URL=http://192.168.0.187:1234/v1
# Use the LM Studio API token when authentication is enabled. Otherwise the
# placeholder `lm-studio` satisfies the OpenAI SDK and is ignored by the server.
OPENAI_BASE_URL=
OPENAI_API_KEY=lm-studio

# OpenRouter connection used by any route whose provider is `openrouter`.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it

# Model identifier exposed by the selected provider. Examples:
#   Ollama Cloud: glm-5.2:cloud
#   LM Studio: qwen/qwen3.5-9b
MODEL=qwen/qwen3.5-9b

# Optional vision-capable model. Defaults to MODEL when omitted.
IMAGE_MODEL=

# Optional structured completion override: native or two-stage.
# Defaults to two-stage for Ollama Cloud and native for local/LM Studio.
STRUCTURED_OUTPUT_STRATEGY=

# --- Local Llama Prompt Guard 2 ---
# Install the pinned ONNX model with:
#   bun run setup:prompt-guard --accept-license
PROMPT_GUARD_MODEL_PATH=models/prompt-guard-2-86m
# Start with CPU. The smoke command can be run with `PROMPT_GUARD_DEVICE=webgpu`
# to compare ONNX Runtime's WebGPU provider on Apple Silicon.
PROMPT_GUARD_DEVICE=cpu
PROMPT_GUARD_THRESHOLD=0.5
PROMPT_GUARD_BATCH_SIZE=16
PROMPT_GUARD_CHUNK_OVERLAP=32

# --- Phoenix tracing ---
# Set to "false" to disable tracing entirely (spans become no-ops).
PHOENIX_TRACING_ENABLED=true
# Local Phoenix from docker-compose.yml (UI + OTLP HTTP on the same port).
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=solenoid-assistant

# --- Structured logging (VictoriaLogs) ---
# Every line the app writes goes three places: the console, the active trace
# span, and VictoriaLogs. Traces stay in Phoenix; this is only the logs, joined
# to them by the `trace_id` and `span_id` on every record.
#
# Shipping is best-effort by construction — records queue in memory and are
# posted in batches, so a collector that is down or slow costs you logs and
# never a request. Set VICTORIALOGS_ENABLED=false to turn it off entirely; the
# console and the span events are unaffected either way.

# Minimum level that reaches the console and the log store: debug, info, warn,
# error. Span events ignore this and always carry the line.
LOG_LEVEL=info
# Console shape: auto (pretty on a terminal, JSON off one), pretty, or json.
LOG_FORMAT=auto
# The `service` field. Each entrypoint names itself — solenoid-server,
# solenoid-worker, solenoid-migrate — so leave this blank unless you are
# running two copies of one of them and need to tell them apart.
LOG_SERVICE=

VICTORIALOGS_ENABLED=true
# Local VictoriaLogs from docker-compose.yml. Inside deploy/compose.yaml this
# is http://victorialogs:9428 instead; the compose file sets it there.
VICTORIALOGS_ENDPOINT=http://localhost:9428
# How many records go in one POST, and how long a partial batch waits.
VICTORIALOGS_BATCH_SIZE=200
VICTORIALOGS_FLUSH_MS=2000
# How many records are held while the collector is unreachable. Past this the
# oldest are dropped — memory is bounded, availability is not negotiable.
VICTORIALOGS_QUEUE_LIMIT=10000
# Applies to both ingestion and the queries the Logs tab makes.
VICTORIALOGS_TIMEOUT_MS=5000

# --- Notion MCP client (OAuth 2.0 + PKCE) ---
# Populated by `bun run scripts/notion-mcp-auth.ts`.
# The codeVerifier and state are temporary (cleared after the auth flow);
# the rest persist for long-lived connections.
NOTION_MCP_REDIRECT_URI=http://localhost:3001/callback
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
NOTION_MCP_CODE_VERIFIER=
NOTION_MCP_STATE=
NOTION_MCP_ACCESS_TOKEN=
NOTION_MCP_REFRESH_TOKEN=
NOTION_MCP_WORKSPACE_ID=
NOTION_MCP_USER_ID=

# Internal Notion integration token used by the deterministic REST search tool.
NOTION_API_TOKEN=

# Notion gallery database IDs for the recommendation ingestion agent.
# These are the IDs of the databases in your Notion workspace that hold each
# collection type. Find them in the database URL: notion.so/<workspace>/<db_id>.
NOTION_DS_BOOKS=
NOTION_DS_MOVIES=
NOTION_DS_TV=
NOTION_DS_MUSIC=
NOTION_DS_GAMES=

# --- Tavily MCP client (live web access: search, extract, crawl, map) ---
# Get an API key at https://app.tavily.com
TAVILY_API_KEY=
