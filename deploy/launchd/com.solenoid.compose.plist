<?xml version="1.0" encoding="UTF-8"?>
<!--
  Brings the stack up at login. Install as a LaunchAgent (per-user, runs after
  login) — a LaunchDaemon would start before Docker Desktop exists:

    cp deploy/launchd/com.solenoid.compose.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.solenoid.compose.plist

  Replace USERNAME below with your short username.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.solenoid.compose</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/Documents/Code/solenoid-assistant/deploy/scripts/compose-up.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SOLENOID_REPO</key>
    <string>/Users/USERNAME/Documents/Code/solenoid-assistant</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- One shot at login. The containers' own restart policy keeps them up
       afterwards, so there is nothing here to babysit. -->
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/solenoid-compose.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/solenoid-compose.log</string>
</dict>
</plist>
